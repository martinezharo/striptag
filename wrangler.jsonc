{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "striptag",
  "compatibility_date": "2026-06-05",
  "observability": {
    "enabled": true
  },
  "compatibility_flags": [
    "global_fetch_strictly_public",
    "nodejs_compat"
  ],
  "assets": {
    "directory": "dist",
    "not_found_handling": "404-page"
  }
}
